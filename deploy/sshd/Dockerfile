# A target host for the phase-0007 credential tests: a real sshd, a real
# account database, and the two things the two credential methods need from a
# target.
#
#   ephemeral-user (D6) needs a privileged provisioning account reachable with
#   the management certificate. That is root here, with the management key in
#   its authorized_keys — which is exactly the deployment prerequisite an
#   operator has to satisfy on a real fleet.
#
#   brokered-key (D6a) needs an account that ALREADY EXISTS and no provisioning
#   rights at all. That is netadmin: it is created here, once, by the image, and
#   the proxy never touches it. A test that finds it modified has found a bug.
#
# Phase 0012 folds this image into the full e2e topology.
FROM debian:stable-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server procps \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /run/sshd /root/.ssh && chmod 700 /root/.ssh \
 && useradd -m -s /bin/sh netadmin \
 && mkdir -p /home/netadmin/.ssh && chmod 700 /home/netadmin/.ssh

# Generated by `make test-sshd`; never committed.
COPY keys/management_key.pub /root/.ssh/authorized_keys
COPY keys/brokered_key.pub /home/netadmin/.ssh/authorized_keys

RUN chmod 600 /root/.ssh/authorized_keys /home/netadmin/.ssh/authorized_keys \
 && chown -R netadmin:netadmin /home/netadmin/.ssh \
 && sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config

EXPOSE 22
# ssh-keygen -A at start rather than at build: a host key baked into an image is
# a host key shared by everyone who pulls it.
CMD ["sh", "-c", "ssh-keygen -A >/dev/null && exec /usr/sbin/sshd -D -e"]
